{
  "name": "tuvansa-erp-backend",
  "version": "1.0.0",
  "description": "Backend Fastify para Tuvansa ERP",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No tests yet\"",
    "analyze:legacy-db": "tsx src/tools/database-discovery/run-legacy-discovery.ts",
    "analyze:legacy-semantic": "tsx src/tools/database-discovery/run-semantic-analysis.ts",
    "analyze:legacy-functional": "tsx src/tools/database-discovery/run-functional-analysis.ts"
  },
  "keywords": [
    "fastify",
    "typescript",
    "erp"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "mysql2": "^3.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
